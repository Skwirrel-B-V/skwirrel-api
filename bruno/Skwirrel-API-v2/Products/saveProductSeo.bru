meta {
  name: saveProductSeo
  type: http
  seq: 4
}

post {
  url: {{base_url}}
  body: json
  auth: none
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "saveProductSeo",
    "params": {
      "token": "{{token}}",
      "product_id": "PRODUCT_ID_HERE",
      "seo": {
        "meta_title": {"nl": "SEO Titel", "en": "SEO Title"},
        "meta_description": {"nl": "SEO omschrijving", "en": "SEO description"},
        "slug": {"nl": "product-slug-nl", "en": "product-slug-en"}
      }
    },
    "id": 1
  }
}

docs {
  Save SEO metadata for a product. Supports multilingual values.
}
