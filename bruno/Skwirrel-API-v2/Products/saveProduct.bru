meta {
  name: saveProduct
  type: http
  seq: 3
}

post {
  url: {{base_url}}
  body: json
  auth: none
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "saveProduct",
    "params": {
      "token": "{{token}}",
      "product": {
        "product_id": null,
        "manufacturer_product_code": "EXAMPLE-001",
        "brand": "ExampleBrand",
        "short_description": {
          "nl": "Korte omschrijving",
          "en": "Short description"
        },
        "long_description": {
          "nl": "Lange omschrijving",
          "en": "Long description"
        },
        "category_id": null,
        "etim_class_id": null,
        "supplier_code": null
      }
    },
    "id": 1
  }
}

docs {
  Create or update a product.
  Set product_id to null for new products. Descriptions support multilingual values.
}
