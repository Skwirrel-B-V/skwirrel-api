meta {
  name: getDenormalizedEtimData
  type: http
  seq: 2
}

post {
  url: {{base_url}}
  body: json
  auth: none
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "getDenormalizedEtimData",
    "params": {
      "token": "{{token}}",
      "etim_class_id": "EC000001",
      "language": "nl"
    },
    "id": 1
  }
}

docs {
  Retrieve denormalized ETIM class data (features, values, units) for a specific class.
}
