meta {
  name: saveTradeItemCustomGroup
  type: http
  seq: 3
}

post {
  url: {{base_url}}
  body: json
  auth: none
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "saveTradeItemCustomGroup",
    "params": {
      "token": "{{token}}",
      "trade_item_id": "TRADE_ITEM_ID_HERE",
      "custom_group": {
        "group_code": "GROUP_CODE",
        "values": [
          {
            "code": "VALUE_CODE",
            "value": {"nl": "Waarde", "en": "Value"}
          }
        ]
      }
    },
    "id": 1
  }
}

docs {
  Save custom group data for a trade item.
}
