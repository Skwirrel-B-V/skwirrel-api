meta {
  name: getPriceLists
  type: http
  seq: 1
}

post {
  url: {{base_url}}
  body: json
  auth: none
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "getPriceLists",
    "params": {
      "token": "{{token}}",
      "price_list_id": null,
      "offset": 0,
      "limit": 50
    },
    "id": 1
  }
}

docs {
  Retrieve price lists. Set price_list_id to null for all.
}
