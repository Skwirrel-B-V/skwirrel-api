						"body": {
							"mode": "raw",
							"raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"getProductsByFilter\",\n  \"params\": {\n    \"token\": \"{{token}}\",\n    \"filter\": {\n      \"brand\": null,\n      \"supplier_code\": null,\n      \"category_id\": null,\n      \"etim_class_id\": null,\n      \"search\": null\n    },\n    \"include_trade_items\": true,\n    \"include_features\": false,\n    \"include_etim\": false,\n    \"include_attachments\": false,\n    \"offset\": 0,\n    \"limit\": 50\n  },\n  \"id\": 1\n}"
						},
