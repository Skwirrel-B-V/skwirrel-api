meta {
  name: getToken
  type: http
  seq: 1
}

post {
  url: {{base_url}}
  body: json
  auth: none
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "getToken",
    "params": {
      "username": "{{username}}",
      "password": "{{password}}"
    },
    "id": 1
  }
}

script:post-response {
  if (res.body.result && res.body.result.token) {
    bru.setVar("token", res.body.result.token);
  }
}

docs {
  Authenticate and obtain an API token.
  The token is automatically stored in the `token` variable.
}
