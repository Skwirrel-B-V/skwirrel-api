meta {
  name: saveGroup
  type: http
  seq: 2
}

post {
  url: {{base_url}}
  body: json
  auth: none
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "saveGroup",
    "params": {
      "token": "{{token}}",
      "group": {
        "group_id": null,
        "group_code": "GRP-001",
        "name": {"nl": "Groepsnaam", "en": "Group name"},
        "product_ids": []
      }
    },
    "id": 1
  }
}

docs {
  Create or update a product group. Set group_id to null for new groups.
}
