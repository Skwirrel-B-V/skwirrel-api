meta {
  name: getCustomFeatures
  type: http
  seq: 2
}

post {
  url: https://{{customer}}.{{domain}}/jsonrpc
  body: json
  auth: inherit
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "getCustomFeatures",
    "params": {
      "limit": 3
    },
    "id": 1
  }
}

docs {
  Retrieve custom classification features

  | Parameter | Type | Required | Description |
  |---|---|---|---|
  | `page` | integer | no | Page number (1-based) |
  | `limit` | integer | no | Maximum number of results per page (1–1000) |
  | `include_feature_translations` | boolean | no | Include translated feature names; requires include_languages |
  | `include_languages` | string[] (nullable) | no | Language codes to include in translations (e.g. ["nl", "fr"]) |

  **Example: All custom features**

  ```json
  {
    "jsonrpc": "2.0",
    "method": "getCustomFeatures",
    "params": {
      "limit": 3
    },
    "id": 1
  }
  ```

  Result:

  ```json
  {
    "custom_features": [
      {
        "custom_feature_id": 1,
        "custom_feature_code": "WEIGHT_NET",
        "custom_feature_type": "N"
      },
      {
        "custom_feature_id": 2,
        "custom_feature_code": "COLOUR",
        "custom_feature_type": "A"
      }
    ],
    "page": {
      "number_of_items": 2,
      "items_per_page": 3,
      "number_of_pages": 1,
      "current_page": 1
    }
  }
  ```
}
