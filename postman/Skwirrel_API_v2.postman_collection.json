{
	"info": {
		"_postman_id": "skwirrel-api-v2-collection",
		"name": "Skwirrel API v2",
		"description": "Skwirrel PIM JSON-RPC 2.0 API.\n\n## Setup\n1. Set the `base_url` variable to your Skwirrel instance (e.g. `https://yourcompany.skwirrel.eu/api/v2/`)\n2. Run the **getToken** request first to authenticate\n3. The token is automatically stored in the `token` variable for all subsequent requests\n\n## JSON-RPC 2.0\nAll requests use POST with a JSON-RPC 2.0 body:\n```json\n{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"methodName\",\n  \"params\": { ... },\n  \"id\": 1\n}\n```",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "https://yourcompany.skwirrel.eu/api/v2/",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "username",
			"value": "",
			"type": "string"
		},
		{
			"key": "password",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Authentication",
			"description": "Obtain an API token. The token is automatically saved to the `token` collection variable.",
			"item": [
				{
					"name": "getToken",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.result && jsonData.result.token) {",
									"    pm.collectionVariables.set('token', jsonData.result.token);",
									"    pm.test('Token stored successfully', function () {",
									"        pm.expect(jsonData.result.token).to.be.a('string');",
									"    });",
									"} else {",
									"    pm.test('Token retrieval failed', function () {",
									"        pm.expect.fail('No token in response: ' + JSON.stringify(jsonData));",
									"    });",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"getToken\",\n  \"params\": {\n    \"username\": \"{{username}}\",\n    \"password\": \"{{password}}\"\n  },\n  \"id\": 1\n}"
						},
						"url": {
							"raw": "{{base_url}}",
							"host": ["{{base_url}}"]
						},
						"description": "Authenticate and obtain an API token. The token is automatically stored in the `token` collection variable via the Tests script.\n\n**Required params:**\n- `username` — API username\n- `password` — API password"
					}
				}
			]
		},
		{
			"name": "Products",
			"description": "Retrieve and manage products.",
			"item": [
				{
					"name": "getProducts",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"getProducts\",\n  \"params\": {\n    \"token\": \"{{token}}\",\n    \"product_id\": null,\n    \"include_trade_items\": true,\n    \"include_features\": false,\n    \"include_etim\": false,\n    \"include_custom_classes\": false,\n    \"include_attachments\": false,\n    \"include_seo\": false,\n    \"include_custom_groups\": false,\n    \"include_related_products\": false,\n    \"offset\": 0,\n    \"limit\": 50,\n    \"modified_since\": null\n  },\n  \"id\": 1\n}"
						},
						"url": {
							"raw": "{{base_url}}",
							"host": ["{{base_url}}"]
						},
						"description": "Retrieve products with optional includes.\n\n**Params:**\n- `token` — Auth token\n- `product_id` — (optional) Specific product ID, or null for all\n- `include_trade_items` — Include trade item data\n- `include_features` — Include product features\n- `include_etim` — Include ETIM classification data\n- `include_custom_classes` — Include custom classification data\n- `include_attachments` — Include attachments/media\n- `include_seo` — Include SEO metadata\n- `include_custom_groups` — Include custom group data\n- `include_related_products` — Include related products\n- `offset` / `limit` — Pagination\n- `modified_since` — ISO date filter for incremental sync"
					}
				},
				{
					"name": "getProducts (single by ID)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"getProducts\",\n  \"params\": {\n    \"token\": \"{{token}}\",\n    \"product_id\": \"PRODUCT_ID_HERE\",\n    \"include_trade_items\": true,\n    \"include_features\": true,\n    \"include_etim\": true,\n    \"include_custom_classes\": true,\n    \"include_attachments\": true,\n    \"include_seo\": true,\n    \"include_custom_groups\": true,\n    \"include_related_products\": true\n  },\n  \"id\": 1\n}"
						},
						"url": {
							"raw": "{{base_url}}",
							"host": ["{{base_url}}"]
						},
						"description": "Retrieve a single product by ID with all includes enabled. Replace `PRODUCT_ID_HERE` with the actual product ID."
					}
				},
