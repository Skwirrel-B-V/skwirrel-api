meta {
  name: saveSimpleTradeItemFeature
  type: http
  seq: 2
}

post {
  url: {{base_url}}
  body: json
  auth: none
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "saveSimpleTradeItemFeature",
    "params": {
      "token": "{{token}}",
      "trade_item_id": "TRADE_ITEM_ID_HERE",
      "feature": {
        "feature_code": "FEATURE_CODE",
        "value": "Feature value",
        "unit": "mm"
      }
    },
    "id": 1
  }
}

docs {
  Save a simple feature value for a trade item.
}
