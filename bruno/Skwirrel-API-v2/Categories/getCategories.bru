meta {
  name: getCategories
  type: http
  seq: 1
}

post {
  url: {{base_url}}
  body: json
  auth: none
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "getCategories",
    "params": {
      "token": "{{token}}",
      "include_products": false,
      "include_custom_classes": false
    },
    "id": 1
  }
}

docs {
  Retrieve the category tree. Optionally include product references and custom classes.
}
