  "components": {
    "schemas": {
      "JsonRpcRequest": {
        "type": "object",
        "required": ["jsonrpc", "method", "params", "id"],
        "properties": {
          "jsonrpc": {
            "type": "string",
            "enum": ["2.0"],
            "description": "JSON-RPC version"
          },
          "method": {
            "type": "string",
            "description": "API method name"
          },
          "params": {
            "type": "object",
            "description": "Method parameters"
          },
          "id": {
            "type": "integer",
            "description": "Request ID"
          }
        }
      },
      "JsonRpcResponse": {
        "type": "object",
        "properties": {
          "jsonrpc": {
            "type": "string",
            "enum": ["2.0"]
          },
          "result": {
            "description": "Response data (present on success)"
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {"type": "integer"},
              "message": {"type": "string"}
            },
            "description": "Error info (present on failure)"
          },
          "id": {
            "type": "integer"
          }
        }
      }
    }
  },
  "tags": [
    {"name": "Authentication", "description": "Token-based authentication"},
    {"name": "Products", "description": "Product CRUD and features"},
    {"name": "Grouped Products", "description": "Product groups (variants, sets)"},
    {"name": "Trade Items", "description": "Trade items (GTINs, packaging)"},
    {"name": "Categories", "description": "Category tree"},
    {"name": "Suppliers", "description": "Supplier management"},
    {"name": "Attachments", "description": "Product media and files"},
    {"name": "Classifications", "description": "ETIM and meta classifications"},
    {"name": "Price Lists", "description": "Price list data"}
  ]
