meta {
  name: getProductsByFilter
  type: http
  seq: 2
}

post {
  url: {{base_url}}
  body: json
  auth: none
}

body:json {
  {
    "jsonrpc": "2.0",
    "method": "getProductsByFilter",
    "params": {
      "token": "{{token}}",
      "filter": {
        "brand": null,
        "supplier_code": null,
        "category_id": null,
        "etim_class_id": null,
        "search": null
      },
      "include_trade_items": true,
      "include_features": false,
      "include_etim": false,
      "include_attachments": false,
      "offset": 0,
      "limit": 50
    },
    "id": 1
  }
}

docs {
  Retrieve products using filter criteria: brand, supplier_code, category_id, etim_class_id, or free text search.
}
