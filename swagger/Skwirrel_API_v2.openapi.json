{
  "openapi": "3.0.3",
  "info": {
    "title": "Skwirrel PIM API v2",
    "version": "2.0.0",
    "description": "Skwirrel Product Information Management JSON-RPC 2.0 API.\n\nAll endpoints use a single POST URL with JSON-RPC 2.0 request bodies. The `method` field determines which operation is called.\n\n## Authentication\n1. Call `getToken` with username/password\n2. Use the returned token in all subsequent requests\n\n## JSON-RPC 2.0 Format\n```json\n{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"methodName\",\n  \"params\": { \"token\": \"...\", ... },\n  \"id\": 1\n}\n```",
    "contact": {
      "name": "Skwirrel",
      "url": "https://skwirrel.eu"
    }
  },
  "servers": [
    {
      "url": "https://{customer}.skwirrel.eu/api/v2",
      "description": "Skwirrel API (per-customer)",
      "variables": {
        "customer": {
          "default": "demo",
          "description": "Customer subdomain"
        }
      }
    }
  ],
  "paths": {
    "/getToken": {
      "post": {
        "operationId": "getToken",
        "tags": ["Authentication"],
        "summary": "Obtain an API token",
        "description": "Authenticate with username and password to receive a session token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonRpcRequest"
              },
              "example": {
                "jsonrpc": "2.0",
                "method": "getToken",
                "params": {
                  "username": "api_user",
                  "password": "api_password"
                },
                "id": 1
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonRpcResponse"
                },
                "example": {
                  "jsonrpc": "2.0",
                  "result": {
                    "token": "abc123def456"
                  },
                  "id": 1
                }
              }
            }
          }
        }
      }
    },
    "/getProducts": {
      "post": {
        "operationId": "getProducts",
        "tags": ["Products"],
        "summary": "Retrieve products",
        "description": "Retrieve one or more products with optional includes for trade items, features, ETIM data, attachments, SEO, custom groups, and related products. Supports pagination and incremental sync via modified_since.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonRpcRequest"
              },
              "example": {
                "jsonrpc": "2.0",
                "method": "getProducts",
                "params": {
                  "token": "{{token}}",
                  "product_id": null,
                  "include_trade_items": true,
                  "include_features": false,
                  "include_etim": false,
                  "include_custom_classes": false,
                  "include_attachments": false,
                  "include_seo": false,
                  "include_custom_groups": false,
                  "include_related_products": false,
                  "offset": 0,
                  "limit": 50,
                  "modified_since": null
                },
                "id": 1
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Products returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonRpcResponse"
                }
              }
            }
          }
        }
      }
    },
    "/getProductsByFilter": {
      "post": {
        "operationId": "getProductsByFilter",
        "tags": ["Products"],
        "summary": "Retrieve products by filter",
        "description": "Retrieve products using filter criteria such as brand, supplier_code, category_id, etim_class_id, or free text search.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonRpcRequest"
              },
              "example": {
                "jsonrpc": "2.0",
                "method": "getProductsByFilter",
                "params": {
                  "token": "{{token}}",
                  "filter": {
                    "brand": null,
                    "supplier_code": null,
                    "category_id": null,
                    "etim_class_id": null,
                    "search": null
                  },
                  "include_trade_items": true,
                  "include_features": false,
                  "include_etim": false,
                  "include_attachments": false,
                  "offset": 0,
                  "limit": 50
                },
                "id": 1
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Filtered products returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonRpcResponse"
                }
              }
            }
          }
        }
      }
    },
    "/saveProduct": {
      "post": {
        "operationId": "saveProduct",
        "tags": ["Products"],
        "summary": "Create or update a product",
        "description": "Create a new product (product_id = null) or update an existing one. Supports multilingual descriptions.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JsonRpcRequest"
              },
              "example": {
                "jsonrpc": "2.0",
                "method": "saveProduct",
                "params": {
                  "token": "{{token}}",
                  "product": {
                    "product_id": null,
                    "manufacturer_product_code": "EXAMPLE-001",
                    "brand": "ExampleBrand",
                    "short_description": {
                      "nl": "Korte omschrijving",
                      "en": "Short description"
                    },
                    "long_description": {
                      "nl": "Lange omschrijving",
                      "en": "Long description"
                    },
                    "category_id": null,
                    "etim_class_id": null,
                    "supplier_code": null
                  }
                },
                "id": 1
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Product saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JsonRpcResponse"
                }
              }
            }
          }
        }
      }
    },
